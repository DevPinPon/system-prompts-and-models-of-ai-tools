{
  "name": "local-replit-agent",
  "version": "1.0.0",
  "description": "Local desktop Replit Agent replica — autonomous AI coding environment with Claude integration and Google Cloud deployment",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:renderer": "vite --port 3000",
    "build": "vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac",
    "build:win": "vite build && electron-builder --win",
    "build:linux": "vite build && electron-builder --linux",
    "docker:build": "docker build -t local-replit-workspace -f docker/Dockerfile.workspace .",
    "docker:run": "docker run -it --rm -p 3001:3001 -v $(pwd)/projects:/workspace local-replit-workspace"
  },
  "build": {
    "appId": "com.local-replit-agent.app",
    "productName": "Local Replit Agent",
    "files": [
      "src/main/**/*",
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google-cloud/run": "^1.4.0",
    "@google-cloud/storage": "^7.14.0",
    "@google-cloud/artifact-registry": "^3.5.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "chokidar": "^4.0.0",
    "dockerode": "^4.0.0",
    "electron-store": "^8.1.0",
    "express": "^4.21.0",
    "monaco-editor": "^0.52.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-icons": "^5.3.0",
    "react-resizable-panels": "^2.1.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "tar-fs": "^3.0.0",
    "tree-kill": "^1.2.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
